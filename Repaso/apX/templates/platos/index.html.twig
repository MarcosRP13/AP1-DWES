{% extends 'base.html.twig' %}

{% block title %}Platos index{% endblock %}

{% block body %}
    <h1>Platos index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>Allergens</th>
                <th>Time_prep</th>
                <th>Stock_dis</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for plato in platos %}
            <tr>
                <td>{{ plato.id }}</td>
                <td>{{ plato.name }}</td>
                <td>{{ plato.description }}</td>
                <td>{{ plato.price }}</td>
                <td>{{ plato.category }}</td>
                <td>{{ plato.allergens }}</td>
                <td>{{ plato.timePrep }}</td>
                <td>{{ plato.stockDis }}</td>
                <td>
                    <a href="{{ path('app_platos_show', {'id': plato.id}) }}">show</a>
                    <a href="{{ path('app_platos_edit', {'id': plato.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_platos_new') }}">Create new</a>
{% endblock %}
