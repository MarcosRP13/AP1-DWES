{% extends 'base.html.twig' %}

{% block title %}Platos{% endblock %}

{% block body %}
    <h1>Platos</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ plato.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ plato.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ plato.description }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ plato.price }}</td>
            </tr>
            <tr>
                <th>Category</th>
                <td>{{ plato.category }}</td>
            </tr>
            <tr>
                <th>Allergens</th>
                <td>{{ plato.allergens }}</td>
            </tr>
            <tr>
                <th>Time_prep</th>
                <td>{{ plato.timePrep }}</td>
            </tr>
            <tr>
                <th>Stock_dis</th>
                <td>{{ plato.stockDis }}</td>
            </tr>
            <tr>
                <th>Camarero</th>
                <td>{{ plato.getWaiterId.name }}</td>
            </tr>
            <tr>
                <th>Pedidos</th>
                <td>{{ plato.pedidos|length }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_platos_index') }}">back to list</a>

    <a href="{{ path('app_platos_edit', {'id': plato.id}) }}">edit</a>

    {{ include('platos/_delete_form.html.twig') }}
{% endblock %}
