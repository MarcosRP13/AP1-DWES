{% extends 'base.html.twig' %}

{% block title %}Clientes{% endblock %}

{% block body %}
    <h1>Clientes</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cliente.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ cliente.name }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ cliente.lastName }}</td>
            </tr>
            <tr>
                <th>Dni</th>
                <td>{{ cliente.dni }}</td>
            </tr>
            <tr>
                <th>Telephone</th>
                <td>{{ cliente.telephone }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ cliente.email }}</td>
            </tr>
            <tr>
                <th>Date_register</th>
                <td>{{ cliente.dateRegister ? cliente.dateRegister|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Vip</th>
                <td>{{ cliente.vip ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_clientes_index') }}">back to list</a>

    <a href="{{ path('app_clientes_edit', {'id': cliente.id}) }}">edit</a>

    {{ include('clientes/_delete_form.html.twig') }}
{% endblock %}
