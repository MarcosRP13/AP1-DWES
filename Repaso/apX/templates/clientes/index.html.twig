{% extends 'base.html.twig' %}

{% block title %}Clientes index{% endblock %}

{% block body %}
    <h1>Clientes index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>LastName</th>
                <th>Dni</th>
                <th>Telephone</th>
                <th>Email</th>
                <th>Date_register</th>
                <th>Vip</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cliente in clientes %}
            <tr>
                <td>{{ cliente.id }}</td>
                <td>{{ cliente.name }}</td>
                <td>{{ cliente.lastName }}</td>
                <td>{{ cliente.dni }}</td>
                <td>{{ cliente.telephone }}</td>
                <td>{{ cliente.email }}</td>
                <td>{{ cliente.dateRegister ? cliente.dateRegister|date('Y-m-d') : '' }}</td>
                <td>{{ cliente.vip ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_clientes_show', {'id': cliente.id}) }}">show</a>
                    <a href="{{ path('app_clientes_edit', {'id': cliente.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_clientes_new') }}">Create new</a>
{% endblock %}
