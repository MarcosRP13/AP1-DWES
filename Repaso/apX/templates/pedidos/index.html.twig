{% extends 'base.html.twig' %}

{% block title %}Pedidos index{% endblock %}

{% block body %}
    <h1>Pedidos index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date_order</th>
                <th>Date_ent</th>
                <th>Quantity</th>
                <th>State</th>
                <th>Observation</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for pedido in pedidos %}
            <tr>
                <td>{{ pedido.id }}</td>
                <td>{{ pedido.dateOrder ? pedido.dateOrder|date('Y-m-d') : '' }}</td>
                <td>{{ pedido.dateEnt ? pedido.dateEnt|date('Y-m-d') : '' }}</td>
                <td>{{ pedido.quantity }}</td>
                <td>{{ pedido.state }}</td>
                <td>{{ pedido.observation }}</td>
                <td>
                    <a href="{{ path('app_pedidos_show', {'id': pedido.id}) }}">show</a>
                    <a href="{{ path('app_pedidos_edit', {'id': pedido.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_pedidos_new') }}">Create new</a>
{% endblock %}
